{
  "name": "youtube-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "build:schema": "node scripts/build-schema.mjs",
    "prebuild": "node scripts/build-schema.mjs",
    "predev": "node scripts/build-schema.mjs",
    "pretest": "node scripts/build-schema.mjs",
    "pretest:e2e": "pnpm exec playwright install --with-deps chromium",
    "preseed": "node scripts/build-schema.mjs && pnpm exec playwright install chromium",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "preseed:demo": "node scripts/build-schema.mjs && pnpm exec playwright install chromium",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@electric-sql/pglite": "^0.5.5",
    "@neondatabase/serverless": "^1.1.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.8",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/dom-webcodecs": "^0.1.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.15"
  }
}
