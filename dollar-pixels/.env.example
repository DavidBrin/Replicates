# Dollar Pixels — configuration
#
# Every variable here is optional. With an empty environment the app runs
# fully: fake money, in-memory storage, no accounts anywhere. That is the
# intended way to try it locally.

# ---------------------------------------------------------------- payments --

# Which payment provider settles orders.
#   mock    (default) an in-app fake checkout. No keys, no network, no account.
#           Buying is free and instant, and the grid fills with play money.
#   stripe  real Stripe hosted Checkout.
#
# Choosing `stripe` without the two secrets below is a FATAL startup error, not
# a warning. A deploy that silently stops charging is worse than one that
# refuses to boot (DECISIONS D11).
PAYMENT_PROVIDER=mock

# Stripe secret key. Server-side only — never prefix this NEXT_PUBLIC_.
# Test keys start sk_test_, live keys start sk_live_.
# STRIPE_SECRET_KEY=

# Stripe webhook signing secret for THIS endpoint, from the dashboard or from
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Server-side only. Per-endpoint AND per-mode: the test-mode secret will not
# verify live-mode events.
# STRIPE_WEBHOOK_SECRET=

# Platform cut of block sales on premium pages, in basis points.
# 0 (the default) means the creator receives 100% of every block sold on their
# page, which is what the product promises out of the box.
# 250 would be 2.5%.
PLATFORM_FEE_BPS=0

# ----------------------------------------------------------------- storage --

# Where pages, claims, orders and the ledger live.
#   memory    (default) in-process, held on globalThis. Resets when the server
#             restarts, and is per-instance — on Vercel each function instance
#             gets its own copy. Fine for local dev and for a throwaway demo
#             deploy; not a real store.
#   postgres  Neon (or any Postgres). Required for a deployment that must
#             remember anything (DECISIONS D13).
STORE_DRIVER=memory

# Postgres connection string. Required when STORE_DRIVER=postgres.
# Vercel's Neon integration injects this for you.
# DATABASE_URL=

# ------------------------------------------------------------------- auth --

# Secret used to sign the demo session cookie. A random development value is
# generated per process if this is unset, which means sessions do not survive
# a restart and will not work across multiple instances. Set it in production.
# Generate one with: openssl rand -base64 32
# AUTH_SECRET=
