# fake-phone — environment
#
# EVERY VARIABLE BELOW IS OPTIONAL. With none of them set the app is fully
# functional: it opens into a ringing call and speaks a written half-conversation
# through the browser's own voice. Nothing here is needed to build, test, deploy
# or use fake-phone — these switches only light up the optional AI voice tier.
#
# Copy to `.env.local` (git-ignored) if you want to enable it.

# ---------------------------------------------------------------- server ----
# Read server-side only, in `src/lib/voice/config.ts` (marked `server-only`).
# A key never reaches the browser and never appears in any response body.

# Override for which tier the server will serve: scripted | ai
# Leave unset and it is inferred — `ai` when the selected provider's key is
# present, `scripted` otherwise. Set it to `scripted` as a kill switch to keep
# the AI tier off even with a key configured.
VOICE_PROVIDER=

# Which vendor the AI tier calls: anthropic | openai
# Defaults to `anthropic` (the house model). Only `anthropic` has a client in
# this build; `openai` is a declared seam — see `lib/voice/text-model-registry.ts`.
# Setting it to `openai` is treated as an UNCONFIGURED deployment: the voice
# routes answer 503 and the app serves the scripted tier, rather than minting
# sessions for calls that could never be placed.
AI_PROVIDER=

# The one thing you actually need to turn the AI tier on.
ANTHROPIC_API_KEY=

# Reserved for the `openai` provider. Unused until that client exists.
OPENAI_API_KEY=

# Optional. Signs the voice session tokens that `/api/voice/session` mints and
# `/api/voice/turn` verifies — which is how the call duration cap is enforced
# across serverless instances without any shared storage. Leave it unset and the
# signing key is derived from the provider key above, so the AI tier still needs
# exactly one variable to work.
# Set it (any long random string) if you rotate the provider key: without it, a
# rotation invalidates every live session, which ends calls in progress a few
# minutes early. It is a secret, read server-side only, and never reaches the
# browser — the token it signs carries no part of it.
VOICE_SESSION_SECRET=

# Cost guardrails (research/ai-voice-architecture.md §6). Both have defaults, so
# a paid provider can never ship without limits.
# Hard cutoff for a single call, in seconds. Default 240 (4 minutes) — well
# under Vercel's 300s Hobby function ceiling, so behaviour is identical on every
# plan. Accepted range 40–600; anything outside it falls back to the default.
# The floor is not arbitrary: the call wraps up in persona 20s before the cutoff,
# so a smaller budget would be spent before the first line was ever requested.
VOICE_CALL_MAX_DURATION_SECONDS=

# Output-token budget for a whole call. The call ends in persona when it is
# spent, never mid-word. Default 2000. Accepted range 800–8000 — same reasoning:
# a turn may spend up to 400 tokens and the wrap-up margin is another 400, so
# below 800 the call would end before it started.
VOICE_CALL_MAX_TOKENS=

# ---------------------------------------------------------------- client ----
# Public, inlined into the browser bundle at build time. Carries no secret.

# Lets the client-side provider registry offer the AI tier without a network
# round trip. The server routes remain the real authority: with this `true` and
# no key configured they still return 503 and the call degrades cleanly.
NEXT_PUBLIC_VOICE_AI_ENABLED=
