# ---------------------------------------------------------------------------
# Every variable here has a working default. A fresh clone runs with an empty
# environment: `npm install && npm run dev`. Nothing in this file is required
# until you deploy.
# ---------------------------------------------------------------------------

# --- persistence -----------------------------------------------------------

# Which engine to use: `pglite` | `neon`. Both are Postgres.
#
#   pglite — Postgres compiled to WebAssembly, running in-process against a
#            local directory. No service to install, no container. The default
#            when DATABASE_URL is unset, and refused outright in production
#            because its storage does not survive a serverless invocation.
#   neon   — hosted Postgres. What a deployment uses. Selected automatically
#            when DATABASE_URL is set.
#
# Usually you do not set this: the presence of DATABASE_URL decides. Set it to
# force the choice — the e2e suite pins `pglite` so a developer with a real
# connection string exported cannot have the tests seed into it.
# DB_DRIVER=pglite

# Where PGlite keeps its data, relative to the project root.
# DB_DATA_DIR=.data/linear

# Neon (or any Postgres) connection string. Setting this selects `neon`.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- auth ------------------------------------------------------------------

# Signs the session cookie. Generate with: openssl rand -base64 32
# In development an ephemeral key is derived if this is unset, with a loud
# warning — every restart invalidates every session. In production the app
# refuses to boot without it.
# AUTH_SECRET=

# How long a session lasts, in seconds. Default 30 days.
# SESSION_TTL_SECONDS=2592000

# --- workspace defaults ----------------------------------------------------

# Seed a demo workspace (teams, issues, projects, members) on first boot of an
# empty database. Handy for a deployed demo; off by default.
# SEED_DEMO_DATA=false

# Anyone with the link can create an account. Set to `false` to make the
# instance invite-only after the first user signs up.
# ALLOW_OPEN_SIGNUP=true

# --- AI connectors ---------------------------------------------------------
#
# Both are optional and server-side only. With neither key set the AI panel
# renders in a disabled state that explains what to configure — the feature
# degrades, it does not break.

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# Which provider the UI offers by default: `anthropic` | `openai` | `none`.
# AI_DEFAULT_PROVIDER=anthropic
