{
  "name": "risk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "db:push": "node --experimental-strip-types scripts/db-push.ts",
    "build:schema": "node scripts/build-schema.mjs",
    "prebuild": "node scripts/build-schema.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "test:e2e:capture": "CAPTURE=1 playwright test screenshots --project=desktop-chrome",
    "build:maps": "node --experimental-strip-types scripts/build-maps.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@neondatabase/serverless": "^1.1.0",
    "clsx": "^2.1.1",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "polylabel": "^2.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "d3-geo": "^3.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fast-check": "^4.3.0",
    "jsdom": "^30.0.1",
    "mapshaper": "^0.7.74",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "description": "A browser replica of RISK: Global Domination — solo vs bots, pass-and-play, and casual online play."
}
