# Every variable here is OPTIONAL.
# The app is designed to run with none of them set — `vercel deploy` on a fresh
# clone produces a fully working workspace backed by browser storage.

# ---------------------------------------------------------------- branding --
# NEXT_PUBLIC_BRAND_NAME="Notion"
# NEXT_PUBLIC_BRAND_TAGLINE="The AI workspace that works for you."
# NEXT_PUBLIC_BRAND_DESCRIPTION="One place where teams find every answer…"

# ----------------------------------------------------------------- storage --
# indexeddb (default) | local | memory | rest
# NEXT_PUBLIC_STORAGE_DRIVER=indexeddb
# NEXT_PUBLIC_STORAGE_KEY="notion-clone:workspace:v1"
# NEXT_PUBLIC_STORAGE_SCHEMA_VERSION=1

# Only read when the driver is `rest`.
# NEXT_PUBLIC_STORAGE_API_URL="/api/workspace"

# Server-side only. Setting this arms /api/workspace (Neon JSONB snapshot in
# `workspaces`). Also set NEXT_PUBLIC_STORAGE_DRIVER=rest. Schema is created
# automatically on first use; see scripts/schema.sql. Never prefix this with
# NEXT_PUBLIC_ — a connection string must not reach the browser bundle.
# DATABASE_URL="postgres://…"

# Optional shared secret for /api/workspace. When set, requests must send
# matching `x-workspace-secret`. For the browser REST driver, also set
# NEXT_PUBLIC_WORKSPACE_PERSISTENCE_SECRET to the same value (that exposes the
# secret to the client — private demos only).
# WORKSPACE_PERSISTENCE_SECRET="…"
# NEXT_PUBLIC_WORKSPACE_PERSISTENCE_SECRET="…"

# ------------------------------------------------------------------ layout --
# NEXT_PUBLIC_SIDEBAR_WIDTH=240
# NEXT_PUBLIC_PAGE_CONTENT_WIDTH=708
# NEXT_PUBLIC_BOARD_COLUMN_WIDTH=260

# ---------------------------------------------------------------- features --
# NEXT_PUBLIC_ENABLE_PERSISTENCE=true
# NEXT_PUBLIC_ENABLE_PUBLISH=true
# NEXT_PUBLIC_ENABLE_COMMAND_PALETTE=true
# NEXT_PUBLIC_PERSIST_DEBOUNCE_MS=400
