{
  "name": "david-smash",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "next build && wrangler dev --port 8787",
    "deploy": "next build && wrangler deploy",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:online": "playwright test -c playwright.online.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "models:fetch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/models/fetch.mjs",
    "models:skeletons": "node scripts/models/skeletons.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "trystero": "^0.25.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fast-check": "^4.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "wrangler": "4.146.0"
  }
}
