.next/
out/
build/
coverage/

# The local SQLite demo database. Its whole point is to survive a restart
# on one machine; it is not something to share between them.
.data/
*.db
*.db-wal
*.db-shm

test-results/
playwright-report/
blob-report/
.playwright-mcp/
*.tsbuildinfo
.env
.env.local
.env*.local
.DS_Store
.vercel

# wrangler's local state and local secrets (TURN_KEY_ID / TURN_KEY_API_TOKEN for `wrangler dev`).
.wrangler/
.dev.vars
.dev.vars.*

# Nintendo-ripped models and textures (spec §3.1): fetched and built locally by
# `pnpm models`, deployed from local disk, never committed. Only hashes
# (scripts/models/manifest.json) and derived numbers (src/render3d/skeletons/,
# public/bake/) are tracked.
/.model-cache/
/public/models/
*.blend
*.blend1
# Bytecode from the model scripts (they run with -B; this catches a run without it).
__pycache__/
